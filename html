<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Software Engineer Portfolio</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Navigation Bar -->
    <header class="navbar">
        <div class="logo">&lt;DevCustom /&gt;</div>
        <nav>
            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#projects">Projects</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Hero Section -->
    <section id="home" class="hero-section">
        <div class="hero-content">
            <span class="greeting">Hi, my name is</span>
            <h1 class="name">Alex Developer.</h1>
            <h2 class="subtitle">I build scalable software solutions.</h2>
            <p class="description">
                I am a full-stack software engineer specialising in building reliable APIs, 
                optimising databases, and crafting responsive web interfaces.
            </p>
            <div class="hero-buttons">
                <a href="#projects" class="btn btn-primary">View My Work</a>
                <a href="#contact" class="btn btn-secondary">Get In Touch</a>
            </div>
        </div>
    </section>

    <!-- About & Tech Stack Section -->
    <section id="about" class="about-section">
        <h2 class="section-title">About Me</h2>
        <div class="about-grid">
            <div class="about-text">
                <p>Hello! I am a passionate developer who enjoys solving complex technical challenges. My journey involves designing microservices, automating workflows, and learning new cloud systems.</p>
                <p>Here are a few technologies I have been working with recently:</p>
            </div>
            <div class="tech-stack">
                <div class="tech-item">JavaScript (ES6+)</div>
                <div class="tech-item">TypeScript</div>
                <div class="tech-item">Node.js</div>
                <div class="tech-item">Python</div>
                <div class="tech-item">React / Next.js</div>
                <div class="tech-item">Docker & AWS</div>
            </div>
        </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="projects-section">
        <h2 class="section-title">Featured Projects</h2>
        <div class="projects-grid">
            
            <!-- Project Card 1 -->
            <div class="project-card">
                <div class="project-header">
                    <span class="project-icon">📂</span>
                    <div class="project-links">
                        <a href="#" target="_blank">🔗</a>
                    </div>
                </div>
                <h3 class="project-title">E-Commerce Microservices</h3>
                <p class="project-desc">A highly scalable backend architecture processing checkout queues using Node.js, RabbitMQ, and Redis.</p>
                <div class="project-tags">
                    <span>Node.js</span>
                    <span>Docker</span>
                    <span>Redis</span>
                </div>
            </div>

            <!-- Project Card 2 -->
            <div class="project-card">
                <div class="project-header">
                    <span class="project-icon">📂</span>
                    <div class="project-links">
                        <a href="#" target="_blank">🔗</a>
                    </div>
                </div>
                <h3 class="project-title">AI Content Classifier</h3>
                <p class="project-desc">A Python-based NLP system that automatically labels inbound API customer tickets with 94% sorting accuracy.</p>
                <div class="project-tags">
                    <span>Python</span>
                    <span>FastAPI</span>
                    <span>PyTorch</span>
                </div>
            </div>

            <!-- Project Card 3 -->
            <div class="project-card">
                <div class="project-header">
                    <span class="project-icon">📂</span>
                    <div class="project-links">
                        <a href="#" target="_blank">🔗</a>
                    </div>
                </div>
                <h3 class="project-title">DevOps Monitor Dashboard</h3>
                <p class="project-desc">A live real-time React system tracking server resource footprints, RAM load charts, and uptime status.</p>
                <div class="project-tags">
                    <span>React</span>
                    <span>WebSockets</span>
                    <span>Tailwind</span>
                </div>
            </div>

        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact-section">
        <h2 class="section-title">Let's Connect</h2>
        <p>I am currently open to freelance opportunities, full-time engineering roles, and open-source collaborations.</p>
        <a href="mailto:your.email@example.com" class="btn btn-primary email-btn">Say Hello</a>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <p>Designed & Built by Alex Developer &copy; 2026</p>
    </footer>

</body>
</html>
